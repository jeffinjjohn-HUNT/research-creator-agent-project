# Copy to .env and fill in. Never commit real keys.
LLM_PROVIDER=ollama
OLLAMA_URL=http://localhost:11434
REASONING_MODEL=qwen2.5:3b-instruct
FAST_MODEL=qwen2.5:3b-instruct
LLM_TIMEOUT_S=300
LLM_TEMPERATURE=0.2

# Hosted model (use for deployment): set LLM_PROVIDER=groq and add a free key from console.groq.com
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FAST_MODEL=openai/gpt-oss-20b

# Search providers (all optional; see docs/architecture.md for fallbacks)
TAVILY_API_KEY=
BRAVE_API_KEY=
YOUTUBE_API_KEY=

# Budgets
SEARCH_TIMEOUT_S=15
SEARCH_RETRIES=2
MAX_QUERIES_PER_PLATFORM=3
MAX_RESULTS_PER_QUERY=5
MAX_EVIDENCE=15
SEARCH_STAGE_BUDGET_S=45
OLLAMA_NUM_CTX=8192

DATABASE_PATH=data/app.db
# 1 = deterministic offline mock LLM + mock search (demo/tests)
USE_MOCK=0
